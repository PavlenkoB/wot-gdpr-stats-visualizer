{
  "name": "wot-gdpr-stats-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc -b && svelte-check --tsconfig ./tsconfig.app.json --threshold warning",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "geo:country": "node scripts/geo/build-country-table.ts",
    "geo:country:fixture": "node scripts/geo/build-country-table.ts --csv tests/fixtures/geo/country-fixture.csv --out tests/fixtures/geo/country-fixture.bin --month 0000-00 --fixture",
    "geo:map": "node scripts/geo/build-world-map.ts",
    "geo:city": "node scripts/geo/build-city-dataset.ts",
    "geo:city:fixture": "node scripts/geo/build-city-dataset.ts --fixture",
    "geo:map:check": "node scripts/geo/build-world-map.ts --check",
    "vehicles:table": "node scripts/vehicles/build-vehicle-table.ts",
    "vehicles:table:check": "node scripts/vehicles/build-vehicle-table.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "d3-geo": "3.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "topojson-client": "3.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.2",
    "world-atlas": "2.0.2"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0"
  }
}
