# Dependencies
node_modules/

# Build output
dist/
build/

# Vite
.vite/
*.local

# Env files
.env
.env.*
!.env.example

# Testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Large generated build-time assets (regenerated in CI, not committed)
# See .planning/PROJECT.md / ROADMAP.md Phase 6 — the ~60-70MB opt-in
# city-level geo-IP dataset must never be committed to the repo.
# Update this pattern once the actual output path is chosen.
**/geo-city-data/
**/*.citydb.bin

# GSD research-tool cache (transient, not source content)
.planning/research/.cache/

# GSD milestone claim lock (transient, holds a pid and a phase claim)
.planning/milestone.lock

# OS
.DS_Store
Thumbs.db

# GSD runtime artifacts (dispatch-isolation sentinels, scratch state)
.gsd/

# Editors
.vscode/*
!.vscode/extensions.json
.idea
*.iml

# Test fixtures (PII policy from tests/fixtures/README.md)
# Local-only real exports MUST never be committed. Synthetic fixtures
# are generated in memory by tests/fixtures/export-fixtures.ts.
tests/fixtures/private/
# Root-level zips: a real export dropped at the repo root must never
# be staged. Anchored with leading slash so it does not match
# node_modules-style nested paths.
/*.zip

# graphify
graphify-out/manifest.json
graphify-out/cost.json
.graphify_*
graphify-out/cache
graphify-out/*/cost.json
graphify-out/*/graph.json
graphify-out/*/manifest.json
graphify-out/*/GRAPH_REPORT.md

# gsd-core local install artifacts (generated by `npx @opengsd/gsd-core --claude --local`).
# .claude/CLAUDE.md, .claude/settings.json, .claude/hooks/install-gsd-core.sh and
# .claude/skills/ stay tracked; everything below is regenerated tooling.
.claude/.gsd-profile
.claude/agents/
.claude/commands/
.claude/gsd-core/
.claude/scripts/
.claude/gsd-file-manifest.json
.claude/gsd-install-state.json
.claude/gsd-migration-journal/
.claude/hooks/gsd-*
.claude/hooks/lib/
.claude/hooks/managed-hooks-registry.cjs
.claude/hooks/package.json
.claude/worktrees/

# graphify output is generated locally, not published
graphify-out/
