{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "target": "es2023",
    "module": "esnext",
    "types": ["svelte", "vite/client"],
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    /**
     * `.svelte` files embed JS, so `allowJs` stays on: setting it false
     * would not stop the use of JS inside `.svelte` files, but it would
     * break the svelte-check pipeline. There are no `.js` files in `src/`
     * (see `include`), so `checkJs` is deliberately absent — it would be a
     * no-op today and would silently start type-checking any `.js` file a
     * future contributor drops in.
     */
    "allowJs": true,
    "moduleDetection": "force",
    /**
     * Mirrors tsconfig.node.json / tsconfig.test.json so a type-only
     * re-export has to say `export type` explicitly. Already inherited
     * from @tsconfig/svelte; stated here so the three project configs
     * read the same.
     */
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
